// Independent cluster-only foundation entry. Use -C to exclude legacy defaults.
params {
    sample_sheet = null
    rna_sheet = null
    taxid = null
    ncbi_speciesID = null
    taxdump_dir = null
    outdir = "${launchDir}/annotation_preflight"
}
process {
    executor = 'slurm'
    cpus = 1
    memory = '8 GB'
    time = '2h'
    conda = 'conda-forge::python=3.11.9'
    errorStrategy = 'terminate'
    maxRetries = 0
}
conda.enabled = true
singularity.enabled = false
docker.enabled = false
profiles {
    slurm { process.executor = 'slurm' }
}
trace {
    enabled = true
    overwrite = true
    file = "${params.outdir}/preflight_trace.tsv"
}
