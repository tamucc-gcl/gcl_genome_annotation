/*
========================================================================================
    Nextflow config — Genome Annotation Pipeline
========================================================================================
*/

// All pipeline parameter defaults live here. CLI arguments override these values.
params {
    // Shared execution and tool settings
    sample_sheet   = null
    outdir         = "${launchDir}/results"
    publish_dir_mode = 'link'
    min_contig_length = 1000

    // Dfam
    dfam_version = '39'
    dfam_database  = null
    taxa_name      = null

    // Repeat modeller
    repModel_rounds = 3
    repeat_seed = 42
    tetools_version = '1.95'
    dfam_partition_count = 17 // Full Dfam 3.9 FamDB
    dfam_release_url = 'https://www.dfam.org/releases/Dfam_3.9/families/FamDB'
    repeat_library = null // Optional complete masking library; null builds de novo + Dfam
    repeat_filter_database = null // Otherwise use diamond_database/swissprot.dmnd
    repeat_reclassify = true // Preserve the existing Terrier step
    repeat_mask_benchmark = false // Tiny cluster fixtures compare against one unsplit batch
    repeat_mask_cpus = 48
    repeat_mask_memory = '300 GB'
    repeat_mask_time = '96h'
    repeat_diamond_version = '2.1.11'

    // Repeat curation
    min_repeat_length = 100
    cluster_pct       = 0.95   // set to 0 or null to skip clustering

    // Repeat reclassification (Terrier)
    terrier_threshold = 0.7    // min probability for Terrier classification

    // Repeat library filtering
    repeat_filter_pident = 25     // min % identity to flag as gene-derived
    repeat_filter_evalue = 1e-10  // max e-value for repeat library BLASTX

    // RepeatMasker
    job_speed = 's'            // null, 's', 'q', 'qq'
    n_rm_chunks = 8          // number of chunks to split genome into for parallel RepeatMasker runs. Adjust based on genome size and available resources.

    // Telomere annotation
    telomere_motif       = null   // Override; null lets preflight resolve the motif from taxonomy
    telomere_window      = 1000      // tidk window size (bp)
    telomere_min_count   = 2          // min repeat hits per window to call telomeric
    telomere_end_window  = 50000      // classify as terminal if within this distance of scaffold end

    // Infernal
    n_infernal_chunks = 7 // number of chunks to split genome into for parallel Infernal runs. Adjust based on genome size and available resources.
    rfam_database = null // path to Rfam database directory (contains Rfam.cm and Rfam.clanin files)
    rfam_version = 'CURRENT' // only one version

    // Braker Params
    braker_rounds     = 8
    braker_ab_initio  = false // Additional AUGUSTUS predictions without hints; ES mode runs regardless.
    braker_container = 'docker://teambraker/braker3:v3.0.8'
    braker_cpus = 48
    braker_threads = 48 // BRAKER warns against more than 48 GeneMark threads.
    braker_memory = '200 GB'
    braker_time = '240h'
    braker_augustus_config = '/opt/Augustus/config'
    braker_check_only = false // Development runtime check: no training or prediction.
    braker_inputs_root = null // Prediction-only entry; defaults to outdir.
    orthodb_database  = null  // permanent store for OrthoDB
    orthodb_clade     = null                       // OrthoDB override; null lets preflight resolve the clade from taxonomy
    ref_proteome_accession = null  // NCBI accession for close relative (e.g. 'GCF_900700415.2' for Clupea harengus)

    // Post-BRAKER gene model filtering
    filter_max_aed = null // AED filtering is opt-in; inspect scores before choosing a threshold.
    filter_aed_source = null // When filtering: 'rna' or 'protein'; no combined/legacy AED.
    filter_min_cds_length    = 300   // min CDS bp for single-exon genes (100 aa)
    filter_min_gene_length   = 200   // min gene span bp
    filter_min_intron_length = 10    // genes with ALL introns below this are removed

    // Structural QC
    busco_lineage = null // Override; null lets preflight resolve the lineage from taxonomy
    busco_database = '/work/birdlab/databases/busco'
    oma_db_name = 'LUCA'   //https://omabrowser.org/oma/current/ see here for names
    omark_database = '/work/birdlab/databases/omark'
    ncbi_speciesID = null

    // TE gene flagging
    te_flag_overlap_frac = 0.5    // min fraction of gene covered by repeats
    te_flag_evalue       = 1e-10  // max e-value for protein-vs-TE BLASTP

    // Functional Annotations
    n_chunks = 8 // number of chunks to split proteins into for parallel processing in InterProScan, Diamond, eggNOG. Adjust based on size of proteome and available resources.

    interproscan_database = null //'/work/birdlab/databases/interproscan_datasets'
    interproscan_version = '5.77-108.0' //'5.77-108.0'

    eggnog_database = null //'/work/birdlab/databases/eggnog_datasets'
    eggnog_version = '5.0.2' //'5.0.2'
    eggnog_evalue = 0.001
    eggnog_sensemode = 'sensitive' //{fast,mid-sensitive,sensitive,more-sensitive,very-sensitive,ultra-sensitive}
    eggnog_taxid = null // set to specific NCBI taxid (e.g. 7898 for Actinopterygii) to restrict to that lineage, or 'none' for no restriction
    eggnog_target_orthologs = 'all'
    eggnog_goEvidence = "non-electronic"

    diamond_database = null // path to diamond database (e.g. nr or custom db)
    diamond_version = 'swissprot' //only swissprot download enabled. Will get most recent version available at time of pipeline run. To use custom diamond database, set --diamond_database to path of database and set --diamond_version to custom
    diamond_sensitivity = 'sensitive' // {fast, sensitive, more-sensitive, very-sensitive, ultra-sensitive}
    diamond_maxHits = 1
    diamond_evalue = 1e-5
    diamond_qcov = 70

    kofamscan_database = null // path to kofamscan database directory (contains profiles and ko_list)
    kofamscan_version = 'latest' // only one version

    // Input contracts: null species settings are resolved from taxonomy.
    rna_sheet = null
    taxid = null
    taxdump_dir = null
    species = null
    genetic_code = null
    protein_fastas = null
    // Shared general databases use their database directory. Spike-ins stay in the project.
    protein_source_store = "${launchDir}/protein_source_store"
    use_protein_evidence = true
    trim_adapters = true
    trim_quality = true
    subset_fraction = 1.0
    subset_seed = 42
    strandedness = 'auto'
    // Conservative RNA trimming: low-quality 3-prime tails, 4-base window, Q20.
    rna_trim_quality = 20
    rna_trim_window = 4
    rna_min_read_length = 30
    rna_max_n_bases = 5
    // Alignment development entry uses accepted preparation outputs.
    rna_prepared_status = null // default: outdir/rna/rna_status.json
    rna_reference_dir = null // default: outdir/filtered_assemblies
    rna_alignment_seed = 42
    rna_no_temp_splicesite = true // Disable within-run splice-site reuse; real pilot showed runaway memory with reuse.
    rna_alignment_cpus = 16 // Includes mapper and sorting threads.
    rna_alignment_threads = 14 // Tool threads are independent of the CPU reservation.
    rna_alignment_memory = '48 GB' // Headroom for mapping and sorting with splice-site reuse disabled.
    rna_min_intron = 20
    rna_max_intron = 500000
    rna_strand_min_mapq = 20
    rna_strand_min_informative = 100
    rna_strand_dominant_fraction = 0.9
    rna_strand_unstranded_tolerance = 0.1
    run_busco = true
    run_baseline_qc = true // Unfiltered QC after optional UTR refinement in main.nf.
    run_aed = true // Native RNA/protein AED on the validated final models; no filtering.
    baseline_inputs_root = null // Development QC entry: default uses outdir.
    aed_inputs_root = null // Development scoring entry: default uses outdir.
    aed_reassemble_rna = false // Reuse retained ETP/StringTie assemblies when present.
    aed_alignment_cpus = 64
    aed_alignment_memory = '300 GB'
    aed_alignment_time = '96h'
    ingenannot_rna_cds_only = true // Coding-support AED; does not assess UTR boundary quality.
    ingenannot_rna_penalty = 0.25 // Published profile; not a calibrated filtering threshold.
    ingenannot_aed_cpus = 64
    ingenannot_aed_memory = '300 GB'
    ingenannot_aed_time = '96h' // Full protein evidence assessment can exceed one day.
    utr_inputs_root = null // UTR pilot: accepted output root; defaults to outdir.
    utr_refine = true // Optional native UTR refinement; RNA-free assemblies pass through unchanged.
    utr_ranking_cpus = 16
    utr_ranking_memory = '64 GB'
    utr_ranking_time = '96h'
    utr_sj_threshold = 0.05
    utr_cov_threshold = 0.05
    utr_alt_threshold = 0.1
    run_omark = true
    run_eggnog = true
    run_diamond = true
    run_interproscan = true
    run_kofamscan = true
    run_deepsig = true
    run_infernal = true
    run_trnascan = true
    run_telomere = true
    run_centromere = true
}

// ── Process labels ───────────────────────────────────────────────────────────
process {
    executor = 'slurm'
    queue = 'normal'
    scratch = '/scratch'
    stageInMode = 'copy'
    errorStrategy = 'retry'
    maxRetries = 2
    queueSize = 25
    withName: 'PLAN_RNA_ALIGNMENT|PLAN_CONNECTED_RNA_ALIGNMENT|PLAN_BRAKER_INPUTS' {
        scratch = false
        cpus = 1
        memory = '8 GB'
        time = '2h'
        conda = 'conda-forge::python=3.11.9'
        container = null
        errorStrategy = 'terminate'
    }
    withName: 'PLAN_CONNECTED_RNA_ALIGNMENT' {
        // Resolve references back to the native FILTER_ASSEMBLY outputs, rather
        // than new planner copies whose paths change each time this planner runs.
        stageInMode = 'symlink'
    }
    withLabel: rna_strand {
        cpus = 1
        memory = '8 GB'
        time = '2h'
        conda = 'conda-forge::python=3.11.9'
        container = null
        errorStrategy = 'terminate'
    }
    withLabel: rna_index {
        cpus = 8
        memory = '48 GB'
        time = '12h'
        conda = 'python=3.11.9 hisat2=2.2.1'
        container = null
        errorStrategy = 'terminate'
    }
    withLabel: rna_align {
        cpus = params.rna_alignment_cpus
        memory = params.rna_alignment_memory
        time = '48h'
        conda = 'python=3.11.9 hisat2=2.2.1 samtools=1.21'
        container = null
        errorStrategy = 'terminate'
    }
    withLabel: rna_alignment_qc {
        cpus = 1
        memory = '8 GB'
        time = '24h'
        conda = 'python=3.11.9 pysam=0.22.1'
        container = null
        errorStrategy = 'terminate'
    }

    submitRateLimit = '10/1sec'

    // Foundation and protein preparation use lightweight, fail-fast Python tasks.
    // Keep these settings scoped so legacy tool environments remain independent.
    withName: 'RESOLVE_ANNOTATION_INPUTS|ASSERT_ANNOTATION_INPUTS|PLAN_PROTEIN_EVIDENCE|ACQUIRE_PROTEIN_SOURCE|PUBLISH_FAILED_PROTEIN_SOURCE|STORE_PROTEIN_SOURCE|COMBINE_PROTEIN_EVIDENCE|REPORT_PROTEIN_EVIDENCE|ASSERT_PROTEIN_EVIDENCE' {
        cpus = 1
        memory = '8 GB'
        time = '2h'
        conda = 'conda-forge::python=3.11.9'
        container = null
        errorStrategy = 'terminate'
        maxRetries = 0
    }
    withName: 'ACQUIRE_PROTEIN_SOURCE' {
        conda = 'conda-forge::python=3.11.9 conda-forge::ncbi-datasets-cli=18.35.0'
        memory = '32 GB'
        time = '48h'
    }
    withName: 'COMBINE_PROTEIN_EVIDENCE' {
        stageInMode = 'symlink'
        time = '24h'
    }
    withName: 'STORE_PROTEIN_SOURCE' {
        // Finalize on the driver host so its immediate output check sees the
        // same filesystem metadata as the native storeDir transfer.
        // Acquisition and scientific tasks retain the Slurm executor.
        executor = 'local'
        scratch = false
        stageInMode = 'copy'
        stageOutMode = 'move'
        time = '24h'
    }
    withName: 'PUBLISH_FAILED_PROTEIN_SOURCE' {
        stageInMode = 'copy'
    }
    // Planners inspect shared paths from user configuration rather than staged reads.
    withName: 'RESOLVE_ANNOTATION_INPUTS|PLAN_PROTEIN_EVIDENCE|PLAN_RNA_PREPARATION' {
        scratch = false
    }
    withName: 'PLAN_RNA_PREPARATION|ACQUIRE_RNA_READSET|QC_RNA_RAW|TRIM_RNA_READSET|QC_RNA_PROCESSED|SUBSET_RNA_READSET|REPORT_RNA_PREPARATION|ASSERT_RNA_PREPARATION' {
        cpus = 1
        memory = '8 GB'
        time = '2h'
        conda = 'conda-forge::python=3.11.9'
        container = null
        errorStrategy = 'terminate'
        maxRetries = 0
    }
    withName: 'ACQUIRE_RNA_READSET' {
        // Local FASTQ validation needs only Python. SRA is required only for accessions.
        conda = {
            def source = new groovy.json.JsonSlurper().parseText(new String(request.decodeBase64(), 'UTF-8'))
            source.run_accession ? 'python=3.11.9 sra-tools=3.1.1' : 'conda-forge::python=3.11.9'
        }
        cpus = 4
        memory = '16 GB'
        time = '48h'
    }
    withName: 'QC_RNA_RAW|QC_RNA_PROCESSED' {
        conda = 'python=3.11.9 fastqc=0.12.1'
        cpus = 2
        time = '12h'
    }
    withName: 'TRIM_RNA_READSET' {
        conda = 'python=3.11.9 fastp=0.24.0'
        cpus = 4
        memory = '16 GB'
        time = '24h'
    }
    withName: 'SUBSET_RNA_READSET' {
        time = '24h'
    }
    withName: 'REPORT_RNA_PREPARATION' {
        conda = 'python=3.11.9 multiqc=1.25.1'
        time = '4h'
    }
    withName: 'REPORT_RNA_ALIGNMENT' {
        cpus = 1
        memory = '8 GB'
        time = '4h'
        conda = 'python=3.11.9 multiqc=1.25.1'
        container = null
        errorStrategy = 'terminate'
    }
    withName: 'AUDIT_REPEAT_LIBRARY|VALIDATE_REFERENCE_REPEATS|COMPARE_REPEAT_MASKS|REPORT_REFERENCE_REPEATS|ASSERT_REFERENCE_REPEATS' {
        cpus = 1
        memory = '8 GB'
        time = '4h'
        conda = 'conda-forge::python=3.11.9'
        container = null
        errorStrategy = 'terminate'
        maxRetries = 0
    }
    withLabel: 'repeat' {
        container = "docker://dfam/tetools:${params.tetools_version}"
        containerOptions = params.dfam_database ? "--bind ${params.dfam_database}/dfam_db:/opt/RepeatMasker/Libraries/famdb:ro" : ''
        cpus   = 64
        memory = '300.GB'
        time   = '96.h'
    }

    withLabel: 'curate_repeat' {
        conda = 'python=3.11.9 cd-hit=4.8.1'
        stageInMode = 'symlink'
        cpus   = 64
        memory = '300.GB'
        time   = '96.h'
    }

    withLabel: 'repeat_classify' {
        container = "docker://dfam/tetools:${params.tetools_version}"
        containerOptions = params.dfam_database ? "--bind ${params.dfam_database}/dfam_db:/opt/RepeatMasker/Libraries/famdb:ro" : ''
        cpus   = 5
        memory = '50.GB'
        time   = '96.h'
    }

    withLabel: 'reclassify_repeats' {
        conda = "${projectDir}/environments/terrier.yaml"
        cpus   = 4
        memory = '16 GB'
        time   = '1h'
    }

    withLabel: 'dfam' {
        container = "docker://dfam/tetools:${params.tetools_version}"
        containerOptions = "--bind ${params.dfam_database}"
        stageInMode = 'symlink'
        cpus   = 5
        memory = '50.GB'
        time   = '96.h'
    }

    withLabel: 'prep_rm_batches' {
        conda = 'conda-forge::python=3.11.9'
        cpus   = 4
        memory = '8 GB'
        time   = '1h'
    }

    withLabel: 'repeat_mask_batch' {
        container = "docker://dfam/tetools:${params.tetools_version}"
        containerOptions = '' // Custom -lib masking needs no FamDB directory
        cpus   = params.repeat_mask_cpus
        memory = params.repeat_mask_memory
        time   = params.repeat_mask_time
    }

    withLabel: 'combine_libs' {
        stageInMode = 'symlink'
        cpus   = 1
        memory = '1 GB'
        time   = '30m'
    }

    withLabel: 'merge_rm' {
        container = "docker://dfam/tetools:${params.tetools_version}"
        containerOptions = ''
        stageInMode = 'symlink'
        cpus   = 2
        memory = '16 GB'
        time   = '4h'
    }

    withLabel: 'braker' {
        container = params.braker_container
        conda = null
        cpus = params.braker_cpus
        memory = params.braker_memory
        time = params.braker_time
        errorStrategy = 'terminate'
    }
    withLabel: 'braker_runtime' {
        container = params.braker_container
        conda = null
        cpus = 1
        memory = '8 GB'
        time = '2h'
        errorStrategy = 'terminate'
    }
    withLabel: 'braker_inputs' {
        container = null
        conda = 'python=3.11.9 pysam=0.22.1'
        cpus = 1
        memory = '8 GB'
        time = '4h'
        errorStrategy = 'terminate'
    }
    withLabel: 'braker_report' {
        container = null
        conda = 'conda-forge::python=3.11.9'
        cpus = 1
        memory = '8 GB'
        time = '4h'
        errorStrategy = 'terminate'
    }

    withLabel: trna_scan {
      conda = 'bioconda::trnascan-se'
      cpus = 16
      time = '4h'
      memory = '32 GB'
    }


    withLabel: busco {
      conda = 'bioconda::busco=5.3.2 bioconda::augustus=3.3'
      cpus = 64
      time = '4h'
      memory = '32 GB'
    }

    withLabel: busco_download {
      conda = 'bioconda::busco=5.3.2'
      cpus = 2
      time = '2h'
      memory = '4 GB'
    }

    withLabel: omark_download {
      conda = 'bioconda::omark'
      cpus = 2
      time = '2h'
      memory = '4 GB'
    }

    withLabel: omark {
      conda = 'bioconda::omark'
      cpus = 24
      time = '6h'
      memory = '50 GB'
    }

    withLabel: baseline_python {
      cpus = 1
      memory = '4 GB'
      time = '2h'
      conda = 'conda-forge::python=3.11.9'
      container = null
      errorStrategy = 'terminate'
      maxRetries = 0
    }
    withLabel: aed_python {
      cpus = 1
      memory = '16 GB'
      time = '24h'
      conda = 'conda-forge::python=3.11.9'
      container = null
      errorStrategy = 'terminate'
      maxRetries = 0
    }
    withLabel: aed_stringtie {
      cpus = 8
      memory = '32 GB'
      time = '24h'
      conda = 'bioconda::stringtie=2.2.1'
      container = null
      errorStrategy = 'terminate'
    }
    withLabel: ingenannot {
      cpus = 4
      memory = '32 GB'
      time = '24h'
      conda = "${projectDir}/environments/ingenannot.yaml"
      container = null
      errorStrategy = 'terminate'
      maxRetries = 0
    }
    withName: RUN_INGENANNOT_AED {
      cpus = params.ingenannot_aed_cpus
      memory = params.ingenannot_aed_memory
      time = params.ingenannot_aed_time
    }
    withLabel: utr_ranking {
      cpus = params.utr_ranking_cpus
      memory = params.utr_ranking_memory
      time = params.utr_ranking_time
      conda = "${projectDir}/environments/ingenannot.yaml"
      container = null
      errorStrategy = 'terminate'
      maxRetries = 0
    }
    withLabel: utr_sequences {
      cpus = 2
      memory = '16 GB'
      time = '12h'
      conda = 'python=3.11.9 gffread=0.12.7'
      container = null
      errorStrategy = 'terminate'
    }
    withName: UTR_AGAT {
      ext.qc_stage = 'utr'
    }
    withName: '.*FINAL_ANNOTATION_QC:.*' {
      ext.qc_stage = 'final'
    }
    withName: 'ANNOTATION_POSTPROCESSING:RUN_INGENANNOT_AED' {
      ext.aed_stage = 'aed'
    }
    withName: 'FINALIZE_UTR_ANNOTATION|VALIDATE_UTR_REFINEMENT' {
      memory = '48 GB'
      time = '24h'
    }
    withName: '.*:AGAT|.*:BUSCO|.*:OMARK' {
      stageInMode = 'symlink'
    }
    // Native database downloads use the same host as the storeDir output check.
    withName: '.*:DOWNLOAD_BUSCO_DB|.*:DOWNLOAD_OMARK_DB' {
      executor = 'local'
      scratch = false
      errorStrategy = 'terminate'
    }

    withLabel: agat {
      scratch = false
      conda = "${projectDir}/environments/agat.yaml"
      cpus = 5
      time = '6h'
      memory = '10 GB'
    }

    withLabel: download_db {
      cpus = 2
      time = '24h'
      memory = '25 GB'
    }

    withLabel: download_dfam_db {
      conda = 'bioconda::aria2'
      cpus = 16
      time = '24h'
      memory = '150 GB'
    }

    withLabel: interproscan {
      container = 'docker://interpro/interproscan:5.77-108.0'
      containerOptions = "-B ${params.interproscan_database}/interproscan-data-${params.interproscan_version}/data:/opt/interproscan/data"
      cpus = 32
      time = '96h'
      memory = '150 GB'
    }

    withLabel: chunk_proteins {
      conda = 'bioconda::seqkit'
      cpus = 10
      time = '6h'
      memory = '100 GB'
    }

    withLabel: mergeFiles {
      cpus = 1
      time = '10h'
      memory = '50 GB'
    }

    withLabel: eggnog {
      conda = "bioconda::eggnog-mapper"
      cpus = 32
      time = '96h'
      memory = '150 GB'
    }

    withLabel: diamond {
      conda = "bioconda::diamond"
      cpus = 32
      time = '96h'
      memory = '150 GB'
    }

    withLabel: download_diamond_db {
      conda = "bioconda::diamond"
      cpus = 5
      time = '2h'
      memory = '25 GB'
    }

    withLabel: deepsig {
      //container = 'docker://bolognabiocomp/deepsig'
      //conda = "bioconda::deepsig"
      conda = "${projectDir}/environments/deepsig.yaml"
      cpus = 16
      time = '96h'
      memory = '50 GB'
      //scratch = false //tmp debuging
    }

    withLabel: kofamscan {
      conda = "bioconda::kofamscan"
      cpus = 32
      time = '96h'
      memory = '150 GB'
      //scratch = false //tmp debuging
    }

    withLabel: download_rfam_db {
      conda = "bioconda::infernal"
      cpus = 5
      time = '6h'
      memory = '50 GB'
    }

    withLabel: 'chunk_genome' {
        conda = 'bioconda::seqkit'
        stageInMode = 'symlink'
        cpus   = 4
        memory = '8 GB'
        time   = '1h'
    }

    withLabel: infernal {
      conda = "bioconda::infernal"
      cpus = 64
      time = '96h'
      memory = '300 GB'
    }

    withLabel: 'filter_assembly' {
      conda = 'conda-forge::python=3.11.9'
      cpus   = 2
      memory = '8 GB'
      time   = '1h'
    }

    withLabel: 'telomere' {
        conda = 'bioconda::tidk'
        cpus   = 2
        memory = '8 GB'
        time   = '1h'
    }

    withLabel: centromere {
      conda = "qjh96::centroanno"
      cpus = 16
      time = '12h'
      memory = '16 GB'
    }

    withLabel: 'extract_sequences' {
        conda = 'bioconda::gffread bioconda::seqkit'
        cpus   = 2
        memory = '8 GB'
        time   = '1h'
    }

    withLabel: 'annotation_report' {
        conda = 'r-base r-ggplot2 r-dplyr r-tidyr r-scales r-patchwork r-optparse conda-forge::r-treemapify bioconda::bioconductor-go.db bioconda::bioconductor-annotationdbi'
        cpus   = 2
        memory = '8 GB'
        time   = '1h'
    }

    withLabel: 'filter_repeat_lib' {
        conda = "python=3.11.9 diamond=${params.repeat_diamond_version} seqkit=2.9.0"
        stageInMode = 'symlink'
        cpus   = 16
        memory = '32 GB'
        time   = '2h'
    }

    withLabel: 'repeat_peps_index' {
        conda = "python=3.11.9 diamond=${params.repeat_diamond_version}"
        container = null
        cpus = 4
        memory = '8 GB'
        time = '2h'
    }

    withLabel: 'flag_te_genes' {
        conda = 'bioconda::diamond bioconda::bedtools bioconda::seqkit'
        cpus   = 16
        memory = '32 GB'
        time   = '4h'
    }

    withLabel: 'prepare_protein_db' {
        conda = 'conda-forge::ncbi-datasets-cli'
        cpus   = 2
        memory = '8 GB'
        time   = '2h'
    }

    withLabel: 'merge_functional_annotations' {
        cpus   = 2
        memory = '120 GB'
        time   = '10h'
    }

    withLabel: 'computeAed' {
        conda  = "${projectDir}/environments/miniprot.yaml"
        cpus   = 64
        memory = '300 GB'
        time   = '96h'
    }

    withName: ALIGN_AED_PROTEINS {
        cpus = params.aed_alignment_cpus
        memory = params.aed_alignment_memory
        time = params.aed_alignment_time
        errorStrategy = 'terminate'
        maxRetries = 0
    }

    withLabel: 'rename_gene_models' {
        conda = 'python=3.11'
        cpus   = 2
        memory = '8 GB'
        time   = '2h'
    }
}

conda {
  enabled = true
  cacheDir = '/work/birdlab/.conda_builds'
  autoActivate = true
  channels = ['conda-forge', 'bioconda']
  createOptions = '--override-channels --strict-channel-priority'
  createTimeout = '2 h'
}

singularity {
  enabled = true
  autoMounts = true
  cacheDir = '/work/birdlab/singularity_cache'
  runOptions = '--cleanenv'
  envWhitelist = 'SINGULARITY_BINDPATH,SINGULARITY_LD_LIBRARY_PATH'
}

// ── Profiles ─────────────────────────────────────────────────────────────────
profiles {
    slurm {
        process.executor = 'slurm'
        conda.enabled = true
        singularity.enabled = true
    }

    local {
        process.executor = 'local'
        process.cpus = 4
        conda.enabled = true
        singularity.enabled = true
  }
  docker {
    docker.enabled = true
    process.container = 'quay.io/biocontainers/nextflow:latest'
  }
}

// ── Reports ──────────────────────────────────────────────────────────────────
// Enable timeline and resource reports
timeline {
  enabled = true
  overwrite = true
  file = "${params.outdir}/pipeline/pipeline_timeline.html"
}

report {
  enabled = true
  overwrite = true
  file = "${params.outdir}/pipeline/pipeline_report.html"
}

trace {
  enabled = true
  overwrite = true
  file = "${params.outdir}/pipeline/pipeline_trace.txt"
}

// Enhanced DAG configuration in nextflow.config
dag {
  enabled = true
  overwrite = true
  file = "${params.outdir}/pipeline/pipeline_dag.html"

  // Additional styling options
  graph {
    // Graph-level attributes
    rankdir = 'TB'          // Top to bottom layout (TB, BT, LR, RL)
    bgcolor = 'white'       // Background color
    fontname = 'Arial'      // Font for the graph
    fontsize = 14           // Font size
    dpi = 300              // Resolution for PNG output
  }

  node {
    // Node-level attributes
    shape = 'box'           // Node shape (box, ellipse, circle, etc.)
    style = 'rounded,filled' // Node style
    fillcolor = 'lightblue' // Default fill color
    fontname = 'Arial'      // Font for nodes
    fontsize = 12           // Font size for nodes
  }

  edge {
    // Edge-level attributes
    color = 'gray'          // Edge color
    fontname = 'Arial'      // Font for edge labels
    fontsize = 10           // Font size for edge labels
  }
}
