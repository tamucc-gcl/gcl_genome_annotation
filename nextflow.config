/*
========================================================================================
    Nextflow config — Genome Annotation Pipeline
========================================================================================
*/

// ── Default parameters ───────────────────────────────────────────────────────
params {
    sample_sheet            = null
    outdir                  = "${launchDir}/results"
    dfam_database           = null
    taxa_name               = null
    min_repeat_length       = 100
    cluster_pct             = 0.95
    job_speed               = 's'
    interproscan_version = '5.77-108.0' //'5.77-108.0'
    eggnog_version = '5.0.2' //'5.0.2'
}

// ── Process labels ───────────────────────────────────────────────────────────
process {
    executor = 'slurm'
    queue = 'normal'
    scratch = '/scratch'
    stageInMode = 'copy'
    errorStrategy = 'retry'
    maxRetries = 2
    queueSize = 25
    submitRateLimit = '10/1sec'

    withLabel: 'repeat' {
        container = 'docker://dfam/tetools:latest'
        containerOptions = "--bind ${params.dfam_database}"
        cpus   = 64
        memory = '300.GB'
        time   = '96.h'
    }

    withLabel: 'curate_repeat' {
        conda = 'bioconda::seqkit bioconda::cd-hit'
        stageInMode = 'symlink'
        cpus   = 64
        memory = '300.GB'
        time   = '96.h'
    }

    withLabel: 'repeat_classify' {
        container = 'docker://dfam/tetools:latest'
        containerOptions = "--bind ${params.dfam_database}"
        cpus   = 5
        memory = '50.GB'
        time   = '96.h'
    }

    withLabel: 'reclassify_repeats' {
        conda = "${projectDir}/environments/terrier.yaml"
        cpus   = 4
        memory = '16 GB'
        time   = '1h'
    }

    withLabel: 'dfam' {
        container = 'docker://dfam/tetools:latest'
        containerOptions = "--bind ${params.dfam_database}"
        stageInMode = 'symlink'
        cpus   = 5
        memory = '50.GB'
        time   = '96.h'
    }

    withLabel: 'prep_rm_batches' {
        conda = 'bioconda::seqkit'
        stageInMode = 'symlink'
        cpus   = 4
        memory = '8 GB'
        time   = '1h'
    }

    withLabel: 'repeat_mask_batch' {
        container = 'docker://dfam/tetools:latest'
        containerOptions = "--bind ${params.dfam_database}"
        cpus   = 48
        memory = '300 GB'
        time   = '96h'
    }

    withLabel: 'combine_libs' {
        stageInMode = 'symlink'
        cpus   = 1
        memory = '1 GB'
        time   = '30m'
    }

    withLabel: 'merge_rm' {
        container = 'docker://dfam/tetools:latest'
        containerOptions = "--bind ${params.dfam_database}"
        stageInMode = 'symlink'
        cpus   = 2
        memory = '16 GB'
        time   = '4h'
    }

    withLabel: 'braker' {
        container = 'docker://teambraker/braker3:latest'
        //containerOptions = "--bind ${params.augustus_config}"
        cpus   = 48
        memory = '200.GB'
        time   = '240.h'
    }

    withLabel: trna_scan {
      conda = 'bioconda::trnascan-se'
      cpus = 16
      time = '4h'
      memory = '32 GB'
    }


    withLabel: busco {
      conda = 'bioconda::busco=5.3.2 bioconda::augustus=3.3'
      cpus = 64
      time = '4h'
      memory = '32 GB'
    }

    withLabel: busco_download {
      conda = 'bioconda::busco'
      cpus = 2
      time = '2h'
      memory = '4 GB'
    }

    withLabel: omark_download {
      conda = 'bioconda::omark'
      cpus = 2
      time = '2h'
      memory = '4 GB'
    }

    withLabel: omark {
      conda = 'bioconda::omark'
      cpus = 24
      time = '6h'
      memory = '50 GB'
    }

    withLabel: agat {
      conda = "${projectDir}/environments/agat.yaml"
      cpus = 5
      time = '6h'
      memory = '10 GB'
    }

    withLabel: download_db {
      cpus = 2
      time = '24h'
      memory = '25 GB'
    }

    withLabel: download_dfam_db {
      conda = 'bioconda::aria2'
      cpus = 16
      time = '24h'
      memory = '150 GB'
    }

    withLabel: interproscan {
      container = 'docker://interpro/interproscan:5.77-108.0'
      containerOptions = "-B ${params.interproscan_database}/interproscan-data-${params.interproscan_version}/data:/opt/interproscan/data"
      cpus = 32
      time = '96h'
      memory = '150 GB'
    }

    withLabel: chunk_proteins {
      conda = 'bioconda::seqkit'
      cpus = 10
      time = '6h'
      memory = '100 GB'
    }

    withLabel: mergeFiles {
      cpus = 1
      time = '10h'
      memory = '50 GB'
    }

    withLabel: eggnog {
      conda = "bioconda::eggnog-mapper"
      cpus = 32
      time = '96h'
      memory = '150 GB'
    }

    withLabel: diamond {
      conda = "bioconda::diamond"
      cpus = 32
      time = '96h'
      memory = '150 GB'
    }

    withLabel: download_diamond_db {
      conda = "bioconda::diamond"
      cpus = 5
      time = '2h'
      memory = '25 GB'
    }

    withLabel: deepsig {
      //container = 'docker://bolognabiocomp/deepsig'
      //conda = "bioconda::deepsig"
      conda = "${projectDir}/environments/deepsig.yaml"
      cpus = 16
      time = '96h'
      memory = '50 GB'
      //scratch = false //tmp debuging
    }

    withLabel: kofamscan {
      conda = "bioconda::kofamscan"
      cpus = 32
      time = '96h'
      memory = '150 GB'
      //scratch = false //tmp debuging
    }

    withLabel: download_rfam_db {
      conda = "bioconda::infernal"
      cpus = 5
      time = '6h'
      memory = '50 GB'
    }

    withLabel: 'chunk_genome' {
        conda = 'bioconda::seqkit'
        stageInMode = 'symlink'
        cpus   = 4
        memory = '8 GB'
        time   = '1h'
    }

    withLabel: infernal {
      conda = "bioconda::infernal"
      cpus = 64
      time = '96h'
      memory = '300 GB'
    }

    withLabel: 'filter_assembly' {
      conda = 'bioconda::seqkit bioconda::assembly-stats'
      stageInMode = 'symlink'
      cpus   = 2
      memory = '8 GB'
      time   = '1h'
    }

    withLabel: 'telomere' {
        conda = 'bioconda::tidk'
        cpus   = 2
        memory = '8 GB'
        time   = '1h'
    }

    withLabel: centromere {
      conda = "qjh96::centroanno"
      cpus = 16
      time = '12h'
      memory = '16 GB'
    }

    withLabel: 'extract_sequences' {
        conda = 'bioconda::gffread bioconda::seqkit'
        cpus   = 2
        memory = '8 GB'
        time   = '1h'
    }

    withLabel: 'annotation_report' {
        conda = 'r-base r-ggplot2 r-dplyr r-tidyr r-scales r-patchwork r-optparse conda-forge::r-treemapify bioconda::bioconductor-go.db bioconda::bioconductor-annotationdbi'
        cpus   = 2
        memory = '8 GB'
        time   = '1h'
    }

    withLabel: 'filter_repeat_lib' {
        conda = 'bioconda::diamond bioconda::seqkit'
        stageInMode = 'symlink'
        cpus   = 16
        memory = '32 GB'
        time   = '2h'
    }

    withLabel: 'flag_te_genes' {
        conda = 'bioconda::diamond bioconda::bedtools bioconda::seqkit'
        cpus   = 16
        memory = '32 GB'
        time   = '4h'
    }

    withLabel: 'prepare_protein_db' {
        conda = 'conda-forge::ncbi-datasets-cli'
        cpus   = 2
        memory = '8 GB'
        time   = '2h'
    }

    withLabel: 'merge_functional_annotations' {
        cpus   = 2
        memory = '120 GB'
        time   = '10h'
    }

    withLabel: 'computeAed' {
        conda "${projectDir}/environments/miniprot.yaml"
        cpus   = 16
        memory = '32 GB'
        time   = '4h'
    }
}

conda {
  enabled = true
  cacheDir = '/work/birdlab/.conda_builds'
  autoActivate = true
  channels = ['bioconda', 'conda-forge', 'defaults']
  createTimeout = '2 h'
}

singularity {
  enabled = true
  autoMounts = true
  cacheDir = '/work/birdlab/singularity_cache'
  runOptions = '--cleanenv'
  envWhitelist = 'SINGULARITY_BINDPATH,SINGULARITY_LD_LIBRARY_PATH'
}

// ── Profiles ─────────────────────────────────────────────────────────────────
profiles {
    slurm {
        process.executor = 'slurm'
        conda.enabled = true
        singularity.enabled = true
    }
    
    local {
        process.executor = 'local'
        process.cpus = 4
        conda.enabled = true
        singularity.enabled = true
  }
  docker {
    docker.enabled = true
    process.container = 'quay.io/biocontainers/nextflow:latest'
  }
}

// ── Reports ──────────────────────────────────────────────────────────────────
// Enable timeline and resource reports
timeline {
  enabled = true
  overwrite = true
  file = "${params.outdir}/pipeline/pipeline_timeline.html"
}

report {
  enabled = true
  overwrite = true
  file = "${params.outdir}/pipeline/pipeline_report.html"
}

trace {
  enabled = true
  overwrite = true
  file = "${params.outdir}/pipeline/pipeline_trace.txt"
}

// Enhanced DAG configuration in nextflow.config
dag {
  enabled = true
  overwrite = true
  file = "${params.outdir}/pipeline/pipeline_dag.png"
  
  // Additional styling options
  graph {
    // Graph-level attributes
    rankdir = 'TB'          // Top to bottom layout (TB, BT, LR, RL)
    bgcolor = 'white'       // Background color
    fontname = 'Arial'      // Font for the graph
    fontsize = 14           // Font size
    dpi = 300              // Resolution for PNG output
  }
  
  node {
    // Node-level attributes
    shape = 'box'           // Node shape (box, ellipse, circle, etc.)
    style = 'rounded,filled' // Node style
    fillcolor = 'lightblue' // Default fill color
    fontname = 'Arial'      // Font for nodes
    fontsize = 12           // Font size for nodes
  }
  
  edge {
    // Edge-level attributes
    color = 'gray'          // Edge color
    fontname = 'Arial'      // Font for edge labels
    fontsize = 10           // Font size for edge labels
  }
}